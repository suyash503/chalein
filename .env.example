# Postgres connection string (Supabase / Neon).
# Supabase: Project Settings > Database > Connection string > URI
# Use the pooled connection (port 6543) for serverless.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Only set this if you are serving from a custom domain.
# On Vercel it is derived automatically - leave it unset there.
# NEXT_PUBLIC_BASE_URL="https://chalein.app"
